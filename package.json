{
  "name": "practo-sales-automation",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c teal,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "node scripts/ensure-esbuild.mjs && npm run build -w frontend",
    "start": "NODE_ENV=production node backend/src/index.js",
    "start:prod": "npm run build && npm start",
    "seed": "npm run seed -w backend",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy": "node scripts/cf-deploy.mjs",
    "deploy:cf": "npm run build && npm run deploy",
    "cf:check": "npm run build && node scripts/cf-deploy.mjs --dry-run"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^4.122.0"
  },
  "engines": {
    "node": ">=20"
  }
}
