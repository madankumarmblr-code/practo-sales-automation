# Copy to .env for local production runs (optional)
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Persistent SQLite + sheet cache (Docker default: /data)
# DATA_DIR=./data

# Published Google Sheet CSV for inventory / lead generator
# SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=305008958&single=true&output=csv
SHEET_SYNC_MINUTES=15

# Required on multi-instance hosts (Vercel). Signed auth tokens are verified with this secret.
# AUTH_TOKEN_SECRET=replace-with-a-long-random-string

# Durable SQLite snapshots (required on Vercel so Settings / API Integrations persist)
# Create a Blob store in the Vercel project, then paste the write token:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Optional custom object path (private):
# DB_SNAPSHOT_BLOB_PATH=practo-sales/sales.db

# Optional integration secrets (also survive Vercel /tmp SQLite resets)
# GOOGLE_MAPS_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# SERPAPI_API_KEY=
# SENDGRID_API_KEY=
# RESEND_API_KEY=
# HUNTER_API_KEY=
# APIFY_TOKEN=
# OUTSCRAPER_API_KEY=
# WHATSAPP_META_ACCESS_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Or JSON for any provider: INTEGRATION_SECRETS_JSON={"google_maps":{"apiKey":"..."}}
# INTEGRATION_SECRETS_FORCE=1

# CORS: true = reflect request origin, or set a fixed origin URL
CORS_ORIGIN=true

# Optional override for built frontend path
# FRONTEND_DIST=./frontend/dist

# Frontend build only (Vercel UI + separate API):
# VITE_API_BASE=https://api.yourdomain.com
