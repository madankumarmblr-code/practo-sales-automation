# Copy to .env for local production runs (optional)
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# Persistent SQLite + sheet cache (Docker default: /data)
# DATA_DIR=./data

# Published Google Sheet CSV for inventory / lead generator
# SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?gid=305008958&single=true&output=csv
SHEET_SYNC_MINUTES=15

# CORS: true = reflect request origin, or set a fixed origin URL
CORS_ORIGIN=true

# Optional override for built frontend path
# FRONTEND_DIST=./frontend/dist

# Frontend build only (Cloudflare Pages + separate API):
# VITE_API_BASE=https://api.yourdomain.com
